# SunLink direct HTTPS — environment template (Stage 25B)
# Копировать на сервер в защищённый файл с правами 0600.
# НЕ добавлять в Git. НЕ указывать токены Cloudflare здесь.

# Прямой HTTPS listener backend (без reverse proxy)
SUNLINK_HTTPS_PORT=8443

# Пути к сертификату Let's Encrypt для sunlink.pp.ua
# fullchain.pem содержит leaf + intermediate; privkey.pem — закрытый ключ.
SUNLINK_TLS_CERTFILE=/etc/letsencrypt/live/sunlink.pp.ua/fullchain.pem
SUNLINK_TLS_KEYFILE=/etc/letsencrypt/live/sunlink.pp.ua/privkey.pem

# Опционально, только если используется нестандартная цепочка CA:
# SUNLINK_TLS_CA_CERTS=/etc/letsencrypt/live/sunlink.pp.ua/chain.pem

# Источник данных по умолчанию — безопасный DEMO.
# Физический Modbus НЕ включается этим файлом.
SUNLINK_DATA_SOURCE=demo

# Диагностический SQLite (только локальный файл, не production DB)
# SUNLINK_DEMO_DB=/tmp/sunlink-stage12-demo.db
