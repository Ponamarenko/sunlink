# SunLink direct HTTPS + local HTTP — environment template (Stage 25B.1)
# Копировать на сервер в защищённый файл с правами 0600.
# НЕ добавлять в Git. НЕ указывать Cloudflare token здесь.

# Локальный HTTP listener (LAN / диагностика). НЕ открывать в WAN.
SUNLINK_HTTP_HOST=0.0.0.0
SUNLINK_HTTP_PORT=8800

# Публичный HTTPS listener — TLS завершается в Uvicorn (без reverse proxy).
SUNLINK_HTTPS_HOST=0.0.0.0
SUNLINK_HTTPS_PORT=9443

# Пути к сертификату Let's Encrypt для sunlink.pp.ua
SUNLINK_TLS_CERTFILE=/etc/letsencrypt/live/sunlink.pp.ua/fullchain.pem
SUNLINK_TLS_KEYFILE=/etc/letsencrypt/live/sunlink.pp.ua/privkey.pem

# Источник данных по умолчанию — безопасный DEMO.
# Физический Modbus НЕ включается этим файлом.
SUNLINK_DATA_SOURCE=demo
