# SunLink two-listener service — example only (Stage 25B.1)
# НЕ копировать в /etc/systemd/system без отдельного согласования.
# Один процесс = один FastAPI app = один startup/shutdown = один poller.
# HTTP 8800 (LAN) + HTTPS 9443 (TLS в Uvicorn, без reverse proxy).

[Unit]
Description=SunLink backend (local HTTP 8800 + direct HTTPS 9443)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=sunlink
Group=sunlink
WorkingDirectory=/opt/sunlink/backend
EnvironmentFile=/etc/sunlink/sunlink-https.env
ExecStart=/opt/sunlink/venv/bin/python deye_gateway.py
Restart=on-failure
RestartSec=5
TimeoutStopSec=15
KillSignal=SIGTERM

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target

# Порты/хост читаются из EnvironmentFile (tls_config.py).
# Приватный ключ: root:sunlink 0640 либо sunlink:sunlink 0600.
# Не использовать 777 и не делать ключ доступным всем пользователям.
# Не запускать второй экземпляр сервиса — это приведёт к двойному polling.
