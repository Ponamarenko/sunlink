package com.sunportal.mobile.ui

import android.os.Bundle
import androidx.fragment.app.Fragment
import android.view.LayoutInflater
import android.view.View
import android.view.ViewGroup
import android.widget.TextView
import com.sunportal.mobile.databinding.FragmentConnectionBinding
import com.sunportal.mobile.R
import android.widget.Toast
import android.widget.Spinner
import android.widget.ArrayAdapter

/**
 * ConnectionFragment - экран настроек подключения
 */
class ConnectionFragment : Fragment() {

    private var _binding: FragmentConnectionBinding? = null
    private val binding get() = _binding!!

    override fun onCreateView(
        inflater: LayoutInflater,
        container: ViewGroup?,
        savedInstanceState: Bundle?
    ): View {
        _binding = FragmentConnectionBinding.inflate(inflater, container, false)
        return binding.root
    }

    override fun onViewCreated(view: View, savedInstanceState: Bundle?) {
        super.onViewCreated(view, savedInstanceState)
        
        setupUI()
        setupClickListeners()
    }

    private fun setupUI() {
        // Находим элементы в layout
        val connectionTypeSpinner = binding.root.findViewById<Spinner>(R.id.connection_type_spinner)
        val ipAddressText = binding.root.findViewById<TextView>(R.id.ip_address_text)
        val portText = binding.root.findViewById<TextView>(R.id.port_text)
        val usernameText = binding.root.findViewById<TextView>(R.id.username_text)
        val passwordText = binding.root.findViewById<TextView>(R.id.password_text)
        val saveButton = binding.root.findViewById<View>(R.id.save_button)
        val testButton = binding.root.findViewById<View>(R.id.test_button)
        
        // Настройка Spinner с типами подключения
        val connectionTypes = arrayOf("RS485", "ESP32", "Solarman WiFi", "Ethernet")
        val adapter = ArrayAdapter(requireContext(), android.R.layout.simple_spinner_item, connectionTypes)
        adapter.setDropDownViewResource(android.R.layout.simple_spinner_dropdown_item)
        connectionTypeSpinner?.adapter = adapter
        
        // Установка значений по умолчанию
        ipAddressText?.text = "192.168.1.100"
        portText?.text = "8000"
        usernameText?.text = "admin"
        passwordText?.text = "password"
    }

    private fun setupClickListeners() {
        saveButton?.setOnClickListener {
            Toast.makeText(requireContext(), "Настройки сохранены", Toast.LENGTH_SHORT).show()
        }

        testButton?.setOnClickListener {
            Toast.makeText(requireContext(), "Тестовое подключение", Toast.LENGTH_SHORT).show()
        }

        // Кнопки типов подключения
        binding.rs485Button?.setOnClickListener {
            Toast.makeText(requireContext(), "RS485 подключение", Toast.LENGTH_SHORT).show()
        }

        binding.esp32Button?.setOnClickListener {
            Toast.makeText(requireContext(), "ESP32 подключение", Toast.LENGTH_SHORT).show()
        }

        binding.solarmanButton?.setOnClickListener {
            Toast.makeText(requireContext(), "Solarman WiFi подключение", Toast.LENGTH_SHORT).show()
        }

        binding.ethernetButton?.setOnClickListener {
            Toast.makeText(requireContext(), "Ethernet подключение", Toast.LENGTH_SHORT).show()
        }
    }

    override fun onDestroyView() {
        super.onDestroyView()
        _binding = null
    }
}