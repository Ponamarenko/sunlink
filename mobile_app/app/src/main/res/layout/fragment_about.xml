<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/svitgrid_background">

    <TextView
        android:id="@+id/about_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="18sp"
        android:textColor="@color/svitgrid_text_primary"
        android:gravity="center"
        android:lineSpacingExtra="8dp"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Технічна інформація"
        android:textSize="16sp"
        android:textColor="@color/svitgrid_text_primary"
        android:textStyle="bold"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Версія додатку: 1.0.6"
        android:textSize="14sp"
        android:textColor="@color/svitgrid_text_secondary"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Платформа: Android 5.0+"
        android:textSize="14sp"
        android:textColor="@color/svitgrid_text_secondary"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Розробник: SunPortal Team"
        android:textSize="14sp"
        android:textColor="@color/svitgrid_text_secondary"/>

</LinearLayout>