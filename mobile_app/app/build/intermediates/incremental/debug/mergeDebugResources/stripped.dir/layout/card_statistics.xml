<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Статистика за сегодня"
            android:textSize="18sp"
            android:textColor="@color/svitgrid_text_primary"
            android:textStyle="bold"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="PV генерация"
                    android:textSize="12sp"
                    android:textColor="@color/svitgrid_text_secondary"/>

                <TextView
                    android:id="@+id/stats_pv"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0 кВт·ч"
                    android:textSize="20sp"
                    android:textColor="@color/solar_yellow"
                    android:textStyle="bold"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Импорт сети"
                    android:textSize="12sp"
                    android:textColor="@color/svitgrid_text_secondary"/>

                <TextView
                    android:id="@+id/stats_import"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0 кВт·ч"
                    android:textSize="20sp"
                    android:textColor="@color/solar_red"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Экспорт сети"
                    android:textSize="12sp"
                    android:textColor="@color/svitgrid_text_secondary"/>

                <TextView
                    android:id="@+id/stats_export"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0 кВт·ч"
                    android:textSize="20sp"
                    android:textColor="@color/solar_green"
                    android:textStyle="bold"/>

            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Потребление"
                    android:textSize="12sp"
                    android:textColor="@color/svitgrid_text_secondary"/>

                <TextView
                    android:id="@+id/stats_consumption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="0 кВт·ч"
                    android:textSize="20sp"
                    android:textColor="@color/solar_orange"
                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>