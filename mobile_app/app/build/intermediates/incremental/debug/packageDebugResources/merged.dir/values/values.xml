<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:ns1="http://schemas.android.com/tools">
    <color name="material_primary">#1976D2</color>
    <color name="material_primary_dark">#1565C0</color>
    <color name="material_primary_light">#42A5F5</color>
    <color name="neutral_100">#F8FAFC</color>
    <color name="neutral_200">#E2E8F0</color>
    <color name="neutral_300">#CBD5E1</color>
    <color name="neutral_400">#94A3B8</color>
    <color name="neutral_50">#FFFFFF</color>
    <color name="neutral_500">#64748B</color>
    <color name="neutral_600">#475569</color>
    <color name="neutral_700">#334155</color>
    <color name="neutral_800">#1E293B</color>
    <color name="neutral_900">#0F172A</color>
    <color name="solar_blue">#0099CC</color>
    <color name="solar_green">#00C851</color>
    <color name="solar_orange">#FF8C00</color>
    <color name="solar_red">#FF4444</color>
    <color name="solar_yellow">#FFD700</color>
    <color name="svitgrid_accent">#FFD700</color>
    <color name="svitgrid_background">#FBFDFF</color>
    <color name="svitgrid_error">#FF4444</color>
    <color name="svitgrid_info">#0099CC</color>
    <color name="svitgrid_primary">#00668A</color>
    <color name="svitgrid_primary_dark">#004D6A</color>
    <color name="svitgrid_primary_light">#1A8BB8</color>
    <color name="svitgrid_secondary">#4A6B7F</color>
    <color name="svitgrid_secondary_dark">#3A5B6F</color>
    <color name="svitgrid_secondary_light">#6A8B9F</color>
    <color name="svitgrid_success">#00C851</color>
    <color name="svitgrid_surface">#FFFFFF</color>
    <color name="svitgrid_surface_inverse">#191C1D</color>
    <color name="svitgrid_surface_variant">#F5F8FA</color>
    <color name="svitgrid_text_inverse">#FFFFFF</color>
    <color name="svitgrid_text_primary">#191C1D</color>
    <color name="svitgrid_text_secondary">#4A6B7F</color>
    <color name="svitgrid_text_tertiary">#7A8B9F</color>
    <color name="svitgrid_warning">#FF9800</color>
    <string name="app_name">SunPortal</string>
    <style name="DashboardCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_margin">8dp</item>
        <item name="cardCornerRadius">8dp</item>
        <item name="cardElevation">4dp</item>
    </style>
    <style name="DashboardLabel">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/svitgrid_text_secondary</item>
    </style>
    <style name="DashboardTitle">
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">@color/svitgrid_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="DashboardValue">
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">@color/svitgrid_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="EmergencyButton">
        <item name="android:textColor">@color/neutral_50</item>
        <item name="android:background">@color/solar_red</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="EventMessage">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/svitgrid_text_secondary</item>
    </style>
    <style name="EventTime">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/svitgrid_text_tertiary</item>
    </style>
    <style name="EventTitle">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/svitgrid_text_primary</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="RefreshButton">
        <item name="android:textColor">@color/neutral_50</item>
        <item name="android:background">@color/svitgrid_secondary</item>
        <item name="android:textSize">14sp</item>
    </style>
    <style name="Theme.SunLink" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        
        <item name="colorPrimary">@color/svitgrid_primary</item>
        <item name="colorPrimaryVariant">@color/material_primary_dark</item>
        <item name="colorOnPrimary">@color/neutral_50</item>
        
        <item name="colorSecondary">@color/svitgrid_accent</item>
        <item name="colorSecondaryVariant">@color/solar_orange</item>
        <item name="colorOnSecondary">@color/neutral_50</item>
        
        <item name="android:statusBarColor" ns1:targetApi="l">?attr/colorPrimary</item>
        
    </style>
    <style name="Theme.SunPortal" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        
        <item name="colorPrimary">@color/svitgrid_primary</item>
        <item name="colorOnPrimary">@color/neutral_50</item>
        <item name="colorPrimaryDark">@color/svitgrid_primary_dark</item>
        <item name="colorPrimaryVariant">@color/svitgrid_primary_light</item>
        
        
        <item name="colorSecondary">@color/svitgrid_secondary</item>
        <item name="colorOnSecondary">@color/neutral_50</item>
        <item name="colorSecondaryVariant">@color/svitgrid_secondary_light</item>
        
        
        <item name="android:colorBackground">@color/svitgrid_background</item>
        <item name="colorSurface">@color/svitgrid_surface</item>
        <item name="colorSurfaceVariant">@color/svitgrid_surface_variant</item>
        <item name="colorOnSurface">@color/svitgrid_text_primary</item>
        <item name="colorOnSurfaceVariant">@color/svitgrid_text_secondary</item>
        
        
        <item name="android:textColorPrimary">@color/svitgrid_text_primary</item>
        <item name="android:textColorSecondary">@color/svitgrid_text_secondary</item>
        <item name="android:textColorTertiary">@color/svitgrid_text_tertiary</item>
        
        
        <item name="android:statusBarColor">@color/svitgrid_primary</item>
        <item name="android:navigationBarColor">@color/svitgrid_surface</item>
        
        
        <item name="toolbarStyle">@style/Widget.SunPortal.Toolbar</item>
        
        
        <item name="cardCornerRadius">12dp</item>
        <item name="cardElevation">4dp</item>
        
        
        <item name="materialButtonStyle">@style/Widget.SunPortal.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.SunPortal.OutlinedButton</item>
    </style>
    <style name="Widget.SunPortal.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/neutral_50</item>
        <item name="android:background">@color/svitgrid_primary</item>
        <item name="android:padding">16dp</item>
    </style>
    <style name="Widget.SunPortal.OutlinedButton" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/svitgrid_primary</item>
        <item name="android:background">@drawable/button_outline</item>
        <item name="android:padding">16dp</item>
    </style>
    <style name="Widget.SunPortal.Toolbar" parent="Widget.MaterialComponents.Toolbar">
        <item name="android:background">@color/svitgrid_primary</item>
        <item name="android:titleTextColor">@color/neutral_50</item>
        <item name="android:subtitleTextColor">@color/neutral_100</item>
    </style>
</resources>