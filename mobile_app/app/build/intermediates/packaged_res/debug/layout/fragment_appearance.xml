<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/svitgrid_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Вигляд додатку"
            android:textSize="24sp"
            android:textColor="@color/svitgrid_text_primary"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <!-- Тема -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Тема"
            android:textSize="18sp"
            android:textColor="@color/svitgrid_text_primary"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <RadioGroup
            android:id="@+id/theme_radio_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="32dp">

            <RadioButton
                android:id="@+id/radio_day"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Дневная"
                android:textSize="16sp"
                android:textColor="@color/svitgrid_text_primary"
                android:buttonTint="@color/svitgrid_primary"
                android:layout_marginBottom="8dp"/>

            <RadioButton
                android:id="@+id/radio_night"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Нічна"
                android:textSize="16sp"
                android:textColor="@color/svitgrid_text_primary"
                android:buttonTint="@color/svitgrid_primary"
                android:layout_marginBottom="8dp"/>

            <RadioButton
                android:id="@+id/radio_system"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Системна"
                android:textSize="16sp"
                android:textColor="@color/svitgrid_text_primary"
                android:buttonTint="@color/svitgrid_primary"/>

        </RadioGroup>

        <!-- Размер шрифта -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Размер шрифта"
            android:textSize="18sp"
            android:textColor="@color/svitgrid_text_primary"
            android:textStyle="bold"
            android:layout_marginBottom="16dp"/>

        <RadioGroup
            android:id="@+id/font_radio_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="32dp">

            <RadioButton
                android:id="@+id/radio_small"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Маленький"
                android:textSize="16sp"
                android:textColor="@color/svitgrid_text_primary"
                android:buttonTint="@color/svitgrid_primary"
                android:layout_marginBottom="8dp"/>

            <RadioButton
                android:id="@+id/radio_medium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Середній"
                android:textSize="16sp"
                android:textColor="@color/svitgrid_text_primary"
                android:buttonTint="@color/svitgrid_primary"
                android:layout_marginBottom="8dp"/>

            <RadioButton
                android:id="@+id/radio_large"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Великий"
                android:textSize="16sp"
                android:textColor="@color/svitgrid_text_primary"
                android:buttonTint="@color/svitgrid_primary"/>

        </RadioGroup>

        <!-- Кнопка применения -->
        <Button
            android:id="@+id/apply_button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Застосувати налаштування"
            android:textSize="16sp"
            android:textColor="@color/neutral_50"
            android:background="@color/svitgrid_primary"
            android:padding="16dp"/>

    </LinearLayout>

</ScrollView>