<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Light Theme -->
    <style name="Theme.SunPortal" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorOnPrimary">@color/primary_light</item>
        <item name="colorPrimaryVariant">@color/primary_variant</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/secondary_light</item>
        <item name="colorSecondaryVariant">@color/secondary_variant</item>
        <item name="colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/primary_light</item>
        
        <!-- Typography -->
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.SunPortal.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.SunPortal.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.SunPortal.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.SunPortal.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.SunPortal.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.SunPortal.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.SunPortal.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.SunPortal.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.SunPortal.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.SunPortal.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.SunPortal.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.SunPortal.LabelSmall</item>
    </style>
    
    <!-- Dark Theme -->
    <style name="Theme.SunPortal.Dark" parent="Theme.SunPortal">
        <item name="colorPrimary">@color/primary_light</item>
        <item name="colorOnPrimary">@color/primary_dark</item>
        <item name="colorPrimaryVariant">@color/primary</item>
        <item name="colorSecondary">@color/secondary_light</item>
        <item name="colorOnSecondary">@color/secondary_dark</item>
        <item name="colorSecondaryVariant">@color/secondary</item>
        <item name="colorBackground">@color/background_dark</item>
        <item name="colorOnBackground">@color/text_primary_dark</item>
        <item name="colorSurface">@color/surface_dark</item>
        <item name="colorOnSurface">@color/text_primary_dark</item>
        <item name="colorSurfaceVariant">@color/surface_variant_dark</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary_dark</item>
    </style>
    
    <!-- Typography Styles -->
    <style name="TextAppearance.SunPortal.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="fontFamily">monospace</item>
        <item name="fontWeight">700</item>
    </style>
    
    <style name="TextAppearance.SunPortal.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">monospace</item>
        <item name="fontWeight">700</item>
    </style>
    
    <style name="TextAppearance.SunPortal.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">monospace</item>
        <item name="fontWeight">700</item>
    </style>
    
    <style name="TextAppearance.SunPortal.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">monospace</item>
        <item name="fontWeight">500</item>
    </style>
    
    <style name="TextAppearance.SunPortal.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">monospace</item>
        <item name="fontWeight">500</item>
